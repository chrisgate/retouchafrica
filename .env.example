# Database
DATABASE_URL="postgresql://retouch:devpassword@localhost:55432/retouchafrica"

# Session
SESSION_SECRET="replace-with-a-random-32+-character-secret"

# Seed-only admin credentials (used by prisma/seed.ts to create the single AdminUser)
ADMIN_EMAIL="admin@retouchafrica.org"
ADMIN_PASSWORD="change-me-please"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
UPLOADS_DIR="./public/uploads"

# Server
PORT=3000
HOSTNAME=0.0.0.0

# Optional Cloudflare Turnstile CAPTCHA for the public forms (free: dash.cloudflare.com -> Turnstile).
# Active only when BOTH are set. Read at runtime, so no rebuild is needed to change them.
# Add the site's domain(s) to the widget's hostname list in Cloudflare.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional SMTP notifications (leave blank to disable)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
